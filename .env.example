# GEMINI_API_KEY / GEMINI_API_KEYS / GEMINI_API_KEY_1..10:
# Required for Gemini AI API calls (primary chat, STT, TTS).
# You can supply all 10 keys individually (GEMINI_API_KEY_1 through GEMINI_API_KEY_10),
# or comma-separated in GEMINI_API_KEYS. Automatic key rotation triggers on rate limits.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_API_KEYS="key1,key2,key3,key4,key5,key6,key7,key8,key9,key10"
# GEMINI_API_KEY_1="AIza..."
# GEMINI_API_KEY_2="AIza..."
# GEMINI_API_KEY_3="AIza..."
# GEMINI_API_KEY_4="AIza..."
# GEMINI_API_KEY_5="AIza..."
# GEMINI_API_KEY_6="AIza..."
# GEMINI_API_KEY_7="AIza..."
# GEMINI_API_KEY_8="AIza..."
# GEMINI_API_KEY_9="AIza..."
# GEMINI_API_KEY_10="AIza..."

# GROQ_API_KEY / GROQ_API_KEYS / GROQ_API_KEY_1..10:
# Optional failover provider for STT (Whisper), chat, and TTS when Gemini keys are exhausted.
# GROQ_API_KEYS="gsk_1,gsk_2,gsk_3,gsk_4,gsk_5,gsk_6,gsk_7,gsk_8,gsk_9,gsk_10"
# GROQ_API_KEY_1="gsk_..."
# GROQ_API_KEY_2="gsk_..."
# GROQ_API_KEY_3="gsk_..."
# GROQ_API_KEY_4="gsk_..."
# GROQ_API_KEY_5="gsk_..."
# GROQ_API_KEY_6="gsk_..."
# GROQ_API_KEY_7="gsk_..."
# GROQ_API_KEY_8="gsk_..."
# GROQ_API_KEY_9="gsk_..."
# GROQ_API_KEY_10="gsk_..."

# OPENROUTER_API_KEY / OPENROUTER_API_KEYS / OPENROUTER_API_KEY_1..10:
# Optional failover provider for chat, multimodal audio STT, and TTS when Gemini & Groq are exhausted.
# OPENROUTER_API_KEYS="sk-or-1,sk-or-2,sk-or-3,sk-or-4,sk-or-5,sk-or-6,sk-or-7,sk-or-8,sk-or-9,sk-or-10"
# OPENROUTER_API_KEY_1="sk-or-..."
# OPENROUTER_API_KEY_2="sk-or-..."
# OPENROUTER_API_KEY_3="sk-or-..."
# OPENROUTER_API_KEY_4="sk-or-..."
# OPENROUTER_API_KEY_5="sk-or-..."
# OPENROUTER_API_KEY_6="sk-or-..."
# OPENROUTER_API_KEY_7="sk-or-..."
# OPENROUTER_API_KEY_8="sk-or-..."
# OPENROUTER_API_KEY_9="sk-or-..."
# OPENROUTER_API_KEY_10="sk-or-..."

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
